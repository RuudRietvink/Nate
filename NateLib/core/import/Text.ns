
///////////////////////////////////////////////
// Text
///////////////////////////////////////////////
  
import SequenceContainer

code define 150 \u uppercased ${val is text} is text:
    Core::upperCased($val)
  
code define 150 \u lowercased ${val is text} is text:
    Core::lowerCased($val)

code define 150 first \u of ${val is text} is text:
    Core::firstOf($val)

code define 150 rest \u of ${val is text} is text:
    Core::restOf($val)
  
code define 65 length \u of ${val is text},
               ${val is text} 's length is int-32 as const:
    static_cast<int32_t>($val.size())

code define 60 ${val-1 is any} \u @ ${val-2 is text} is text:
    Core::formatted($val-1, __X__GETFORMAT__Core::getFormat($val-2)__)
  
code define 65 stream-out ${char-1 is char}:
    Core::toString($char-1)

code define 65 stream-out ${val is text}:
    $val
