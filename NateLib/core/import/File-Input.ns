
///////////////////////////////////////////////
// File-Input
///////////////////////////////////////////////
  
import File-Input

code:
    #include <fstream>
  
implement object File-Input:
    var stream is {{code std::shared_ptr<std::ifstream> }}
  
    implement new File-Input is File-Input:
       return constructed object
    
    implement ${me} stream is {{code std::shared_ptr<std::istream> }} :
        return {{code _impl->$stream }} is {{code std::shared_ptr<std::istream> }}

    implement ${me} \is ok is boolean:
        return {{code _impl->$stream && _impl->$stream->good() }} is boolean

    implement ${me} \is opened is boolean:
        return {{code _impl->$stream->is_open() }} is boolean

    implement \u open ${me as out} from \u file ${file is text}:
        {{code _impl->$stream.reset(new std::ifstream($file, std::ios::in)) }}

    implement \u close ${me as out}:
        {{code if (_impl->$stream) _impl->$stream->close() }}
