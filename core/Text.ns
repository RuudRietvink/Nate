
///////////////////////////////////////////////
// Text
///////////////////////////////////////////////

code 150 \u uppercased ($val is text) is text (unary):
  Core::upperCased($val)

code 150 first \u of ($val is text) is text (unary):
  Core::firstOf($val)

code 150 rest \u of ($val is text) is text (unary):
  Core::restOf($val)
  
code 150 ($val-1 is (any)) \u @ ($val-2 is text) is text:
  Core::formatted($val-1, Core::getFormat($val-2))
