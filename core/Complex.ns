
///////////////////////////////////////////////
// aliases
///////////////////////////////////////////////

alias "𝑖" "i"

///////////////////////////////////////////////
// Complex Math
///////////////////////////////////////////////

code:
  #include "C:\Users\ruud\source\repos\Nate\core\Complex.h"
	#include <complex>

const i is imaginary := 1

code define 120 ${val-1 is number} \u monomial ${val-2 is imaginary as exact} is imaginary as const:
	$val-1
	
code define 115 ${val-1 is number} \u + ${val-2 is imaginary as exact} is complex as const:
	__RETURN__($val-1, $val-2)

code define 115 ${val-1 is number} \u - ${val-2 is imaginary as exact} is complex as const:
	__RETURN__($val-1, -$val-2)
	
code define 114 ${val is imaginary as exact} is complex as const:
	__RETURN__(0, $val)
	
code define 110 \u real ${val is complex as exact} is float-64 as const:
	$val.real()
  
code define 110 \u imaginary ${val is complex as exact} is float-64 as const:
	$val.imag()
  
code define 110 ${val-1 is complex as exact} \u ^ ${val-2 is number} as same, right:
	std::pow($val-1, $val-2)
    
code define 110 \u \l sqrt ${val is complex as exact} as same:
	std::sqrt($val)
    
code define 110 \u \l round ${val is complex as exact} as same:
	NI
  
code define 110 \u \l floor ${val is complex as exact} as same:
	NI
  
code define 110 \u \l floor_l ${val is complex as exact} floor_r as same:
	NI
  
code define 110 \u \l ceil ${val is complex as exact} as same:
	std::ceil($val)
  
code define 110 \u \l ceil_l ${val is complex as exact} ceil_r as same:
	NI
  
code define 110 \u \l abs ${val is complex as exact} is float-64:
	std::abs($val)
  
code define 110 \u \l abs_l ${val is complex as exact} abs_r is float-64:
	std::abs($val)

code define 110 \u \l log2 ${val is complex as exact} as same:
	NI
  
code define 120 \u ⇑ ${val is number as out, exact} as same:
  ++$val
  
code define 120 ${val is number as out, exact} \u ⇑ as same:
  $val++
  
code define 120 \u ⇓ ${val is number as out, exact} as same:
  NI
  
code define 120 ${val is number as out, exact} \u ⇓ as same:
  NI

code define 120 \u inc# ${val is number as out, exact} as same:
  NI
  
code define 120 ${val is number as out, exact} \u #inc as same:
  NI
  
code define 120 \u dec# ${val is number as out, exact} as same:
  NI
  
code define 120 ${val is number as out, exact} \u #dec as same:
  NI
