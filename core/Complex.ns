
///////////////////////////////////////////////
// aliases
///////////////////////////////////////////////

///////////////////////////////////////////////
// Complex Math
///////////////////////////////////////////////

const i is imaginary := 1
const 𝑖 is imaginary := 1

code 115 ($val-1 is number) \u + ($val-2 is imaginary (exact)) is complex (const):
	Complex($val-1, $val-2)

code 115 ($val-1 is number) \u - ($val-2 is imaginary (exact)) is complex (const):
	Complex($val-1, -$val-2)
	
code 110 \u real ($val is complex (exact)) is float-64 (const):
	$val.real()
  
code 110 \u imaginary ($val is complex (exact)) is float-64 (const):
	$val.imag()
  
code 110 ($val-1 is complex (exact)) \u ^ ($val-2 is number) is complex (right):
	std::pow($val-1, $val-2)
    
code 110 \u \l round ($val is complex (exact)) is complex:
	NI
  
code 110 \u \l floor ($val is complex (exact)) is complex:
	NI
  
code 110 \u \l floor_l ($val is complex (exact)) floor_r is complex:
	NI
  
code 110 \u \l ceil ($val is complex (exact)) is complex:
	std::ceil($val)
  
code 110 \u \l ceil_l ($val is complex (exact)) ceil_r is complex:
	NI
  
code 110 \u \l abs ($val is complex (exact)) is float-64:
	std::abs($val)
  
code 110 \u \l abs_l ($val is complex (exact)) abs_r is float-64:
	std::abs($val)

code 110 \u \l log2 ($val is complex (exact)) is complex:
	NI
  
code 120 \u ⇑ ($val is number (out,exact)) is (same):
  ++$val
  
code 120 ($val is number (out,exact)) \u ⇑ is (same):
  $val++
  
code 120 \u ⇓ ($val is number (out,exact)) is (same):
  NI
  
code 120 ($val is number (out,exact)) \u ⇓ is (same):
  NI

code 120 \u inc# ($val is number (out,exact)) is (same):
  NI
  
code 120 ($val is number (out,exact)) \u #inc is (same):
  NI
  
code 120 \u dec# ($val is number (out,exact)) is (same):
  NI
  
code 120 ($val is number (out,exact)) \u #dec is (same):
  NI
