
///////////////////////////////////////////////
// aliases
///////////////////////////////////////////////

alias "√" "sqrt"
alias "⋅" "*"
alias "π" "pi"
alias "𝑒" "e"
alias "τ" "tau"
alias "⌊" "floor_l"
alias "⌋" "floor_r"
alias "⌈" "ceil_l"
alias "⌉" "ceil_r"
alias "|" "abs_l"
alias "⏐" "abs_r"
alias "log⏨" "log10"
alias "log₁₀" "log10"
alias "log₂" "log2"

///////////////////////////////////////////////
// Math
///////////////////////////////////////////////

const pi is float-64 := 3.14159265358979323
  
const tau is float-64 := 6.283185307179586
  
constant e is float-64 := 2.718281828459045

code define 110 ($val-1 is number) \u ^ ($val-2 is number) is number (highest,right):
	std::pow($val-1, $val-2)
  
code define 110 \u \l sqrt ($val is integer) is float-64:
	std::sqrt($val)
    
code define 110 \u \l sqrt ($val is real) is (same):
	std::sqrt($val)
    
code define 110 \u \l round ($val is real) is (same):
	std::round($val)
  
code define 110 \u \l floor ($val is real) is (same):
	std::floor($val)
  
code define 110 \u \l floor_l ($val is real) floor_r is (same):
	std::floor($val)
  
code define 110 \u \l ceil ($val is real) is (same):
	std::ceil($val)
  
code define 110 \u \l ceil_l ($val is real) ceil_r is (same):
	std::ceil($val)
  
code define 110 \u \l abs ($val is real) is (same):
	std::abs($val)
  
code define 110 \u \l abs_l ($val is real) abs_r is (same):
	std::abs($val)
  
code define 110 \u \l sin ($val is real) is (same):
	std::sin($val)
  
code define 110 \u \l cos ($val is real) is (same):
	std::cos($val)
  
code define 110 \u \l tan ($val is real) is (same):
	std::tan($val)
  
code define 110 \u \l sinh ($val is real) is (same):
	std::sinh($val)
  
code define 110 \u \l cosh ($val is real) is (same):
	std::cosh($val)
  
code define 110 \u tanh ($val is real) is (same):
	std::tanh($val)
  
code define 110 \u asin ($val is real) is (same):
	std::asin($val)
  
code define 110 \u \l acos ($val is real) is (same):
	std::acos($val)
  
code define 110 \u \l atan ($val is real) is (same):
	std::atan($val)
  
code define 110 \u \l log ($val is real) is (same):
	std::log($val)
  
code define 110 \u \l log10 ($val is real) is (same):
	std::log10($val)

code define 110 \u \l log2 ($val is real) is (same):
	std::log2($val)
  
code define 100 ($val-1 is number) \u monomial ($val-2 is number) is number (highest,const):
	$val-1 * $val-2
	
code define 85 ($val-1 is number) \u max ($val-2 is number (same)) is number (same,right):
	std::max($val-1, $val-2)
  
code define 85 ($val-1 is number) \u min ($val-2 is number (same)) is number (same,right):
	std::min($val-1, $val-2)

import Math