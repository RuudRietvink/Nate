
///////////////////////////////////////////////
// Math
///////////////////////////////////////////////

value pi is float-64:
	3.141592653589793
  
value tau is float-64:
	6.283185307179586
  
value e is float-64:
	2.718281828459045

code right 110 ($val-1 is (num)) ^ ($val-2 is (num)) is (num,highest):
	std::pow($val-1, $val-2)
  
code unary left-monomial 110 sqrt ($val is (num)) is float-64:
	std::sqrt($val)
    
code 100 ($val-1 is (num)) monomial ($val-2 is (num)) is (num,highest):
	$val-1 * $val-2
	
code right 85 ($val-1 is (num)) max ($val-2 is (num,same)) is (num,same):
	std::max($val-1, $val-2)
  
code right 85 ($val-1 is (num)) min ($val-2 is (num,same)) is (num,same):
	std::min($val-1, $val-2)
