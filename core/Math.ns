
///////////////////////////////////////////////
// aliases
///////////////////////////////////////////////

alias "√" "sqrt"
alias "⋅" "*"
alias "π" "pi"
alias "τ" "tau"
alias "⌊" "floor_l"
alias "⌋" "floor_r"
alias "⌈" "ceil_l"
alias "⌉" "ceil_r"
alias "|" "abs_l"
alias "⏐" "abs_r"

///////////////////////////////////////////////
// Math
///////////////////////////////////////////////

const pi is float-64 := 3.141592653589793
  
const tau is float-64 := 6.283185307179586
  
constant e is float-64 := 2.718281828459045

code 110 ($val-1 is (num)) \u ^ ($val-2 is (num)) is (num,highest,right):
	std::pow($val-1, $val-2)
  
code 110 \u \l sqrt ($val is (num)) is float-64:
	std::sqrt($val)
    
code 110 \u round ($val is (num)) is int-64:
	std::round($val)
  
code 110 \u floor ($val is (num)) is int-64:
	std::floor($val)
  
code 110 \u \l floor_l ($val is (num)) floor_r is int-64:
	std::floor($val)
  
code 110 \u ceil ($val is (num)) is int-64:
	std::ceil($val)
  
code 110 \u \l ceil_l ($val is (num)) ceil_r is int-64:
	std::ceil($val)
  
code 110 \u abs ($val is (num)) is int-64:
	std::abs($val)
  
code 110 \u \l abs_l ($val is (num)) abs_r is int-64:
	std::abs($val)

code 100 ($val-1 is (num)) \u monomial ($val-2 is (num)) is (num,highest,const):
	$val-1 * $val-2
	
code 85 ($val-1 is (num)) \u max ($val-2 is (num,same)) is (num,same,right):
	std::max($val-1, $val-2)
  
code 85 ($val-1 is (num)) \u min ($val-2 is (num,same)) is (num,same,right):
	std::min($val-1, $val-2)
