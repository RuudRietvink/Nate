
///////////////////////////////////////////////
// Sequence Container
///////////////////////////////////////////////

import Container

code define 65 \u add ($val is (typename)) to ($container is container (template, out)),
               \u append ($val is (typename)) to ($container is container (template, out)):
  $container.push_back($val)
  
code define 65 \u insert ($val is (typename)) to ($container is container (template, out)):
  $container.insert($container.cbegin(), $val)