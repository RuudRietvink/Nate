code:
  #include "C:\Users\ruud\source\repos\Nate\core\Fraction.h"

code define 110 ${val-1 is fraction as exact} \u ^ ${val-2 is number} is fraction as right:
	std::pow($val-1, $val-2)
  
code define 110 \u \l sqrt ${val is fraction as exact} is fraction:
	std::sqrt($val)
    
code define 110 \u \l round ${val is fraction as exact} is fraction:
	std::round($val)
  
code define 110 \u \l floor ${val is fraction as exact} is fraction:
	std::floor($val)
  
code define 110 \u \l floor_l ${val is fraction as exact} floor_r is fraction:
	std::floor($val)
  
code define 110 \u \l ceil ${val is fraction as exact} is fraction:
	std::ceil($val)
  
code define 110 \u \l ceil_l ${val is fraction as exact} ceil_r is fraction:
	std::ceil($val)
  
code define 110 \u \l abs ${val is fraction as exact} is fraction:
	std::abs($val)
  
code define 110 \u \l abs_l ${val is fraction as exact} abs_r is fraction:
	std::abs($val)
  
code define 110 \u \l sin ${val is fraction as exact} is fraction:
	std::sin($val)
  
code define 110 \u \l cos ${val is fraction as exact} is fraction:
	std::cos($val)
  
code define 110 \u \l tan ${val is fraction as exact} is fraction:
	std::tan($val)
  
code define 110 \u \l sinh ${val is fraction as exact} is fraction:
	std::sinh($val)
  
code define 110 \u \l cosh ${val is fraction as exact} is fraction:
	std::cosh($val)
  
code define 110 \u tanh ${val is fraction as exact} is fraction:
	std::tanh($val)
  
code define 110 \u asin ${val is fraction as exact} is fraction:
	std::asin($val)
  
code define 110 \u \l acos ${val is fraction as exact} is fraction:
	std::acos($val)
  
code define 110 \u \l atan ${val is fraction as exact} is fraction:
