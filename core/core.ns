
///////////////////////////////////////////////
// aliases
///////////////////////////////////////////////

alias "÷" "/"
alias "×" "*"

///////////////////////////////////////////////
// operators
///////////////////////////////////////////////
	
code "uminus" 90 uminus ($val-1 is (num)) is (num,highest,const,unary):
	-$val-1
	
code "uplus" 90 uplus ($val-1 is (num)) is (num,highest,const,unary):
	$val-1
	
code "not" 90 not ($cond is boolean) is boolean (const,unary):
	!$cond
  
code "*" 80 ($val-1 is (num)) * ($val-2 is (num)) is (num,highest,const):
	$val-1 * $val-2
	
code "/" 80 ($val-1 is (num)) / ($val-2 is (num)) is (num,highest,const):
	$val-1 / $val-2
	
code "mod" 80 ($val-1 is (num)) mod ($val-2 is (num)) is (num,highest,const):
	$val-1 % $val-2

code "+" 70 ($val-1 is (num)) + ($val-2 is (num)) is (num,highest,const):
	$val-1 + $val-2

code "-" 70 ($val-1 is (num)) - ($val-2 is (num)) is (num,highest,const):
	$val-1 - $val-2
	
code "+" 62 ($val-1 is text) + ($val-2 is text) is text (const):
	$val-1 + $val-2
  
code "if" 60 ($val-1 is (any)) if ($cond is boolean) else ($val-2 is (same)) is (same,const):
	$cond ? $val-1 : $val-2

code "=" 50 ($val-1 is (cmp)) = ($val-2 is (cmp)) is boolean (const):
	$val-1 == $val-2
	
code "!=" 50 ($val-1 is (cmp)) != ($val-2 is (cmp)) is boolean (const):
	$val-1 != $val-2
	
code ">=" 50 ($val-1 is (cmp)) >= ($val-2 is (cmp)) is boolean (const):
	$val-1 >= $val-2
	
code "<=" 50 ($val-1 is (cmp)) <= ($val-2 is (cmp)) is boolean (const):
	$val-1 <= $val-2

code ">" 50 ($val-1 is (cmp)) > ($val-2 is (cmp)) is boolean (const):
	$val-1 > $val-2
	
code "<" 50 ($val-1 is (cmp)) < ($val-2 is (cmp)) is boolean (const):
	$val-1 < $val-2
	
code "and" 40 ($cond-1 is boolean) and ($cond-2 is boolean) is boolean (const):
	$cond-1 && $cond-2

code "or" 35 ($cond-1 is boolean) or ($cond-2 is boolean) is boolean (const):
	$cond-1 || $cond-2
  
///////////////////////////////////////////////
// face value
///////////////////////////////////////////////

code "decrease" 65 decrease ($val-1 is (num,out)) with ($val-2 is (same)) is (same):
  $val-1 -= $val-2
  
code "decrease" 65 decrease ($val is (num,out)) is (same):
  --$val
  
code "increase" 65 increase ($val-1 is (num,out)) with ($val-2 is (same)) is (same):
  $val-1 += $val-2
  
code "increase" 65 increase ($val is (num,out)) is (same):
  ++$val

code "with" 65 increase ($val is (num,out)) is (same):
  nop to handle unary after "with"

///////////////////////////////////////////////
// language
///////////////////////////////////////////////

code "'s" 200 ($owner is (owner)) 's ($prop is (prop)) is (last):
  $owner.$prop

code "of" 200 ($prop is (prop)) of ($owner is (owner)) is (same):
  $owner.$prop