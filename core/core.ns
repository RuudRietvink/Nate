
///////////////////////////////////////////////
// aliases
///////////////////////////////////////////////

alias "÷" "/"
alias "×" "*"
alias "⇑" "inc"
alias "⇓" "dec"

///////////////////////////////////////////////
// operators
///////////////////////////////////////////////
	
code 120 \u uminus ($val-1 is number) is number (same,const):
	-$val-1
	
code 120 \u uplus ($val-1 is number) is number (same,const):
	$val-1
	
code 120 \u not ($cond is boolean) is boolean (const):
	!$cond
  
code 80 ($val-1 is number) \u * ($val-2 is number) is number (highest,const):
	$val-1 * $val-2
	
code 80 ($val-1 is number) \u / ($val-2 is number) is number (highest,const):
	$val-1 / $val-2
	
code 80 ($val-1 is number) \u mod ($val-2 is number) is number (highest,const):
	$val-1 % $val-2

code 70 ($val-1 is number) \u + ($val-2 is number) is number (highest,const):
	$val-1 + $val-2

code 70 ($val-1 is number) \u - ($val-2 is number) is number (highest,const):
	$val-1 - $val-2
	
code 62 ($val-1 is text) \u + ($val-2 is text) is text (const):
	$val-1 + $val-2
  
code 60 ($val-1 is any) \u if ($cond is boolean) \u else ($val-2 is (same)) is (same,const):
	$cond ? $val-1 : $val-2

code 50 ($val-1 is (comphigh, cmp)) \u = ($val-2 is (comphigh, cmp)) is boolean (const):
	$val-1 == $val-2
	
code 50 ($val-1 is (comphigh, cmp)) \u != ($val-2 is (comphigh, cmp)) is boolean (const):
	$val-1 != $val-2
	
code 50 ($val-1 is (comphigh, cmp)) \u >= ($val-2 is (comphigh, cmp)) is boolean (const):
	$val-1 >= $val-2
	
code 50 ($val-1 is (comphigh, cmp)) \u <= ($val-2 is (comphigh, cmp)) is boolean (const):
	$val-1 <= $val-2

code 50 ($val-1 is (comphigh, cmp)) \u > ($val-2 is (comphigh, cmp)) is boolean (const):
	$val-1 > $val-2
	
code 50 ($val-1 is (comphigh, cmp)) \u < ($val-2 is (comphigh, cmp)) is boolean (const):
	$val-1 < $val-2
	
code 40 ($cond-1 is boolean) \u and ($cond-2 is boolean) is boolean (const):
	$cond-1 && $cond-2

code 35 ($cond-1 is boolean) \u or ($cond-2 is boolean) is boolean (const):
	$cond-1 || $cond-2
  
///////////////////////////////////////////////
// face value
///////////////////////////////////////////////

code 120 \u inc ($val is number (out)) is (same):
  ++$val
  
code 120 ($val is number (out)) \u inc is (same):
  $val++
  
code 120 \u dec ($val is number (out)) is (same):
  --$val
  
code 120 ($val is number (out)) \u dec is (same):
  $val--
  
code 65 \u decrease ($val-1 is number (out)) \u with ($val-2 is (same)) is (same):
  $val-1 -= $val-2
  
code 65 \u decrease ($val is number (out)) is (same):
  --$val
  
code 65 \u increase ($val-1 is number (out)) \u with ($val-2 is (same)) is (same):
  $val-1 += $val-2
  
code 65 \u increase ($val is number (out)) is (same):
  ++$val

///////////////////////////////////////////////
// language
///////////////////////////////////////////////

code 200 ($owner is (owner)) 's ($prop is (prop)) is (last):
  $owner.$prop

code 200 ($prop is (prop)) of ($owner is (owner)) is (same):
  $owner.$prop

code 65 stream-out ($val is number):
  $val

code 65 stream-out ($val is boolean):
  $val
