
///////////////////////////////////////////////
// operators
///////////////////////////////////////////////
	
code 90 - ($val-1 is (num)) is (num,highest):
	-$val-1
	
code 90 + ($val-1 is (num)) is (num,highest):
	$val-1
	
code 90 not ($cond is boolean) is boolean:
	!$cond
  
code 80 ($val-1 is (num)) * ($val-2 is (num)) is (num,highest):
	$val-1 * $val-2
	
code 80 ($val-1 is (num)) / ($val-2 is (num)) is (num,highest):
	$val-1 / $val-2
	
code 80 ($val-1 is (num)) mod ($val-2 is (num)) is (num,highest):
	$val-1 % $val-2

code 70 ($val-1 is (num)) plus ($val-2 is (num)) is (num,highest):
	$val-1 + $val-2

code 70 ($val-1 is (num)) minus ($val-2 is (num)) is (num,highest):
	$val-1 - $val-2
	
code 62 ($val-1 is text) plus ($val-2 is text) is text:
	$val-1 + $val-2
  
code 60 ($val-1 is (any)) if ($cond is boolean) else ($val-2 is (same)) is (same):
	$cond ? $val-1 : $val-2

code 50 ($val-1 is (cmp)) = ($val-2 is (cmp)) is boolean:
	$val-1 == $val-2
	
code 50 ($val-1 is (cmp)) != ($val-2 is (cmp)) is boolean:
	$val-1 != $val-2
	
code 50 ($val-1 is (cmp)) >= ($val-2 is (cmp)) is boolean:
	$val-1 >= $val-2
	
code 50 ($val-1 is (cmp)) <= ($val-2 is (cmp)) is boolean:
	$val-1 <= $val-2

code 50 ($val-1 is (cmp)) > ($val-2 is (cmp)) is boolean:
	$val-1 > $val-2
	
code 50 ($val-1 is (cmp)) < ($val-2 is (cmp)) is boolean:
	$val-1 < $val-2
	
code 40 ($cond-1 is boolean) and ($cond-2 is boolean) is boolean:
	$cond-1 && $cond-2

code 35 ($cond-1 is boolean) or ($cond-2 is boolean) is boolean:
	$cond-1 || $cond-2
  
///////////////////////////////////////////////
// face value
///////////////////////////////////////////////

code 65 decrease ($val-1 is (num,out)) with ($val-2 is (same)) is (same):
  $val-1 -= $val-2
  
code 65 decrease ($val is (num,out)) is (same):
  --$val
  
code 65 increase ($val-1 is (num,out)) with ($val-2 is (same)) is (same):
  $val-1 += $val-2
  
code 65 increase ($val is (num,out)) is (same):
  ++$val
  
///////////////////////////////////////////////
// language
///////////////////////////////////////////////

code 200 ($owner is (owner)) 's ($prop is (prop)) is (last):
  $owner.$prop

code 200 ($prop is (prop)) of ($owner is (owner)) is (same):
  $owner.$prop