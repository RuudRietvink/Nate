code:
  #include "C:\Users\ruud\source\repos\Nate\Nate\core\Rational.h"

code define 110 ${val-1 is rational as exact} \u ^ ${val-2 is number} is rational as right:
	std::pow($val-1, $val-2)
  
code define 110 \u \l sqrt ${val is rational as exact} is rational:
	std::sqrt($val)
    
code define 110 \u \l round ${val is rational as exact} is rational:
	std::round($val)
  
code define 110 \u \l floor ${val is rational as exact} is rational:
	std::floor($val)
  
code define 110 \u \l floor_l ${val is rational as exact} floor_r is rational:
	std::floor($val)
  
code define 110 \u \l ceil ${val is rational as exact} is rational:
	std::ceil($val)
  
code define 110 \u \l ceil_l ${val is rational as exact} ceil_r is rational:
	std::ceil($val)
  
code define 110 \u \l abs ${val is rational as exact} is rational:
	std::abs($val)
  
code define 110 \u \l abs_l ${val is rational as exact} abs_r is rational:
	std::abs($val)
  
code define 110 \u \l sin ${val is rational as exact} is rational:
	std::sin($val)
  
code define 110 \u \l cos ${val is rational as exact} is rational:
	std::cos($val)
  
code define 110 \u \l tan ${val is rational as exact} is rational:
	std::tan($val)
  
code define 110 \u \l sinh ${val is rational as exact} is rational:
	std::sinh($val)
  
code define 110 \u \l cosh ${val is rational as exact} is rational:
	std::cosh($val)
  
code define 110 \u tanh ${val is rational as exact} is rational:
	std::tanh($val)
  
code define 110 \u asin ${val is rational as exact} is rational:
	std::asin($val)
  
code define 110 \u \l acos ${val is rational as exact} is rational:
	std::acos($val)
  
code define 110 \u \l atan ${val is rational as exact} is rational:
	std::atan($val)
  
code define 110 \u \l log ${val is rational as exact} is rational:
	std::log($val)
  
code define 110 \u \l log10 ${val is rational as exact} is rational:
	std::log10($val)

code define 110 \u \l log2 ${val is rational as exact} is rational:
	std::log2($val)
  