
///////////////////////////////////////////////
// File-Input
///////////////////////////////////////////////
  
import Output

code:
  #include <fstream>

code define 65 open \u ${stream is File-Output as out} to write to file \u ${file is text},
               open \u ${stream is File-Output as out} for writing to file \u ${file is text}:
  $stream.reset(new std::ofstream($file, std::ios::out))
  
code define 65 \u ${stream is Output} \is opened is boolean:
  ($stream && $stream->is_open())

code define 65 close \u ${stream is File-Output as out}:
  if ($stream) $stream->close()
