
///////////////////////////////////////////////
// Sequence Container
///////////////////////////////////////////////

code define 65 \u add ${val as typename} to ${container is sequence-container as template, out},
               \u append ${val as typename} to ${container is sequence-container as template, out}:
    $container.push_back($val)
  
code define 65 \u insert ${val as typename} in ${container is sequence-container as template, out}:
    $container.push_front($val)

code define 65 first \u of ${container is sequence-container as template} as typename, output:
    $container.front()

code define 65 first \u of ${container is sequence-container as template} as typename, const:
    $container.front()

code define 65 last \u of ${container is sequence-container as template} as typename, output:
    $container.last()

code define 65 last \u of ${container is sequence-container as template} as typename, const:
    $container.last()