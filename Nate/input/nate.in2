declare object Hi:
  record Datum:
    var fun is text
    var count is int-32

  property age is int-32 as readonly
  property datum is Datum
  property prop-hi is int-32
  
  declare new Hi2 is Hi
  declare ${me is Hi} ${world is text} is text


implement object Hi:
  property age:
    get:
      return age
     
  property prop-hi is int-32:
    set:
      prop-hi := value
      return prop-hi

  define yo is text:
    return "Hi"

  define ${me as out} ${world is text} is text:
    prop-hi := -3 + prop-hi
    return "ls " + yo

  implement new Hi2 is Hi:
    return constructed object
    
  implement ${me is Hi} ${world is text} is text:
    return yo + " " + prop-hi + " " + $world



define why so ${serious is text} is boolean:
  output "why so", serious
  return false



program:
  var hello := " world"
  output why so "serious"
  record Rec:
    var fld1 := 3
    var fld2 is text
    var fld3 := 1 + 2i
    var fld4 := ³³/₄₅₆ + ⁸⁄₄₅₆;

  var rec is Rec
  output rec's fld1, rec's fld4

  data data1:
    1, 2, "sdsdds" & "aaa", hello & hello's length
    3, 4&5,
    6&
    7, 8
    "hi", 4 * 5
    
  data data2:
    1 & data1

  error "Hello", hello
  
  var in is Data-Input
  open in for reading from data data1

  var x, y is int-32
  var s is text;
  read from in: x, y, s
  output x,y, xy, ex
  output "hi", "there"&
  output s

  var out is File-Output
  var out2 is Output := out
  output "Before:", out is ok, out is opened
  open out for writing to file "d:\\uit"
  out2 := out
  output
  if out is opened:						              	
    output "Inside:", out is ok, out is opened
    write to out2: "Hello,planet",
    write: 12,13&14&
    write: 15
    write to output: "Hi",
    output "Hi",
    write: "End"
    write:
    write to out2: "Hi there"
    close out
  output "After:", out is ok, out is opened

  var cnt := 2
  cnt := 3
  
  if cnt:
  is 10:
  is 11:
    output "case"
  is 13:
    output "case 13"
    
  if cnt + 1:
  is 10:
  is 11:
    output "case"
  is 13:
    output "case 13"
  else:
    output "else"
    
  if cnt + 2:
  is cnt * 4:
    output "hello"
  is cnt + 4:
  is cnt - 4:
    output "hi"
    cnt := 2

  if cnt + 3:
    is cnt * 4:
      output "hello"
    is cnt + 4:
    is cnt - 4:
      output "hi"
      cnt := 2
    else:
      output "else"
    
  if cnt + 4:
    is 10:
    is 11:
      output "case"
    is cnt * 4:
      output "hello"
    is cnt + 4:
    is cnt - 4:
      output "hi"
      cnt := 2

  if cnt + 5:
  is 10:
  is 11:
    output "case"
  is cnt * 4:
    output "hello"
  is cnt + 4:
  is cnt - 4:
    output "hi"
    cnt := 2
  else:
    output "else"
    

  loop:
    var cnt := 2
  while cnt != 2:
    cnt := 3
    
  loop while cnt != 3:
    var cnt := 2
    cnt := 3
    
  loop for var item in "abcd⅑⅛⅐efg":
    output item

  loop for var lop := 1 to 10 while lop != 20:
    var cnt := 2
    output lop * cnt
    
  loop for var lop := 1 to 10 step 2 while lop != 20:
    var cnt := 2
    output lop * cnt
    
  loop for var lop := 10 down-to 1:
    var cnt := 2
    output lop * cnt
    
  loop for var lop := 10 down-to 1 step 2:
    var cnt := 2 
  while lop != 20:
    output lop * cnt

  if cnt = 3:
    output "Hello, world!"
    cnt := 4

  if cnt != 3:
    var x is float-32 := 3.14
    output x&x,x&
  else:
    var x := 3
    output x,x+1

  if cnt < 3:
    var x is float-64 := 6,28
    output x^x
  else if false:
    var x := 3
    output x,x+1

  if cnt < 3:
    var x is float-64 := 6,28
    output x^x
  else if false:
    var x := 3
    output x,x+1
  else if true:
    var x := 3
    output "Hello, world!"

  if cnt < 3:
    var x is float-64 := 6,28
    output x^x
  else if false:
    var x := 3
    output x,x+1
  else:
    var x := 3
    output "Hello, world!"
    
  if cnt < 3:
    var x is float-64 := 6,28
    output x^x
  else if false:
    var x := 3
    output x,x+1
  else if true:
    var x := 3
    output "Hello, world!"
  else:
    var y := 3
    output "Bye, world!"
