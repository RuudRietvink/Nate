import Text

role Greetable:
  record Greet:
    var greeting is text
    var count is int

  property greet is Greet
  
  define ls ${me is Greetable} ${world is text} is text

declare object Hi as Greetable:
  record Datum:
    var fun is text
    var count is int

  property age is int as readonly
  property datum is Datum

  define new Hi2 is Hi

  define ${me is Hi} ${world is text} is text
  define ls ${me} ${world is text} is text

declare object Hello is Hi as Greetable:
  record Data:
    var greet is text
    var count is int

  property name,address is text
  property age is int as readonly, final
  property data is Data

  define new Hello is Hello

  define ${me as out} greeted is Hello

  define ${me} ${world is text} is text as final

  define hi ${other is Hello} is text
  
  define stream-out ${me} is text
  
  define ls ${me} ${world is text} is text