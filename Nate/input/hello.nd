import Text

role Greetable:
  record Greet:
    var greeting is text
    var count is int

  //property greet is Greet
  property prop-greetable is int
  
  declare ls ${me is Greetable as out} ${world is text} is text

declare object Hi as Greetable:
  record Datum:
    var fun is text
    var count is int

  //property age is int as readonly
  //property datum is Datum
  property prop-hi is int

  declare new Hi2 is Hi

  declare ${me is Hi} ${world is text} is text

declare object Hello is Hi:
  record Data:
    var greet is text
    var count is int

  //property name,address is text
  //property age is int as readonly, final
  property prop-hello is text

  declare new Hello is Hello

  declare ${me as out} greeted is Hello

  declare ${me} ${world is text} is text as final

  declare hi ${other is Hello} is text
  
  declare stream-out ${me} is text
  
  declare ls ${me as out} ${world is text} is text