import Text

declare object Hello:
  record Data:
    var greet is text
    var count is int

  property name,address is text
  property age is int as readonly, final
  property data is Data

  define new Hello is Hello

  define ${me is Hello} ${world is text} is text as final

  define hi ${other is Hello} is text
  
  define stream-out ${me is Hello} is text
