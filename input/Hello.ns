import Hello

implement object Local:
  var localVar := 3
  
  define new Local is Local:
    var result is Local
    construct result
    initialize result
    return result
    
  define ${me is Local} ${world is text} is text:
    return "Local " + world + localVar
    
implement object Hi:
  property age:
    get:
      return age
      
  property greet:
    set:
      greet := value
      return greet

  define new Hi2 is Hi:
    var result is Hi
    construct result
    initialize result
    return result
    
  define yo is text:
    return "Hi"

  define ${me is Hi} ${world is text} is text:
    return yo + " " + age + " " + $world
    
  define ls ${me} ${world is text} is text:
    return "ls " + yo

implement object Hello:
  var myVar := "Hi There"
  var myBool := false
  var myData is Data

  property name:
    get:
      var hi := 3
      return name + myVar
    set:
      var hi := 5
      var temp := name + value + address + hi
      name := temp
      if myBool:
        name := name + myData's greet
      return name
  
  property greet:
    set:
      greet := value
      return greet

  define new Hello is Hello:
    var result is Hello
    construct result
    initialize result
    return result
    
  define get ${me is Hello} age is int-32:
    var hi := 34
    if myBool:
      output "Test", myVar, myData's greet, new Local " world"
    return me's age + age + hi
    
  define greetings is text:
    return "Hello"
    
  define ${me is Hello} greetings is text:
    var other := new Hello
    return "Hello " + hi other

  define ${me is Hello} ${world is text} is text:
    return greetings + " " + $world

  define hi ${other is Hello} is text:
    return other " earth"
  
  define ${me is Hello as out} greeted is Hello:
    myData's greet := me greetings
    var other := me
    return me

  define stream-out ${me is Hello} is text:
    return me greetings  + ", it's " + me " angry world"
    
  define ls ${me is Hello} ${world is text} is text:
    return "ls " + me greetings
   