%require "3.2"
%language "c++"
%define api.namespace {yy}
%define api.parser.class {parser}
%define api.value.type variant
%define api.token.constructor
%define parse.error verbose
%defines
%output "parser.cpp"
%locations
%define api.location.file "location.hpp"
%code requires{
  namespace yy {
    class Lexer;  // Generated by reflex with namespace=yy lexer=Lexer lex=yylex
  }
  class NateParser;
  #include "Expr.h"
}
%parse-param { yy::Lexer& lexer } { NateParser& nate }
%code{
  #include "lex.yy.h"  // header file generated with reflex --header-file
  #include "NateParser.h"
  #undef yylex
  #define yylex lexer.lex  // Within bison's parse() we should invoke lexer.yylex(), not the global yylex()

  int stateExprValue = yy::Lexer::EXPR_VALUE;
  bool outputEnd = true;
  
  void pushState(yy::Lexer& lexer, int aState)
  {
	  if (lexer.debug()) std::cerr << "Push " << aState << std::endl;
	  lexer.push_state(aState);
  }

  void popState(yy::Lexer& lexer)
  {
    if (lexer.debug()) std::cerr << "Pop from " << lexer.start();
	  if (!lexer.states_empty())
	  {
		  lexer.pop_state();
	  }

	  if (lexer.debug()) std::cerr << " to " << lexer.start() << std::endl;
  }

  void setState(yy::Lexer& lexer, int aState)
  {
	  if (lexer.debug()) std::cerr << "Set " << aState << " from " << lexer.start() << std::endl;    
	  lexer.start(aState);
  }

}

%define api.token.prefix {TOK_}
%token <std::string> IDENTIFIER "identifier"
%token <std::string> NUMBER "number"
%token <std::string> FRACTION "fraction"
%token <std::string> STRING "string"
%token <std::string> BOOL "bool"
%token <std::string> WORD "word"
%token EOF 0 "end of file"
%token BEGIN "begin block"
%token END "end block"
%token PROGRAM "program"
%token ERR "error"
%token VAR "var"
%token CODE "code"
%token DEFINE "define"
%token IF "if"
%token ELSE "else"
%token OUTPUT "output"
%token IS "is"
%token RIGHT "right"
%token LOOP "loop"
%token WHILE "while"
%token FOR "for"
%token DOWNTO "down-to"
%token TO "to"
%token STEP "step"
%token RETURN "return"
%token INOUT "inout"
%token RECORD "record"
%token COL ":"
%token ASSIGN ":="
%token EOS "\n"
%token COMMA ","
%token CONCAT "&"
%token OPENPAR "("
%token CLOSEPAR ")"

%type <std::string>              id;
%type <std::string>              arg-id;
%type <std::vector<std::string>> id-list;
%type <std::string>              single-id;
%type <std::string>              is-type;
%type <std::string>              type;
%type <std::string>              inout;
%type <std::vector<Expr>>        var-init-assign;
%type <std::vector<Expr>>        var-init-list;
%type <std::vector<Expr>>        expr-list;
%type <Expr>                     var-init;
%type <bool>                     for-to;
%type <Expr>                     step;
%type <Expr>                     expr;
%type <Expr>					           expr-value-start;
%type <Expr>					           expr-value-next;
%type <Expr>                     expr-value-parts;
%type <Expr>					           expr-value-part;
%type <Expr>					           expr-word-start;
%type <Expr>					           expr-word-next;
%type <Expr>                     expr-word-parts;
%type <Expr>					           expr-word-part;
%type <Expr>					           expr-word;
%type <Expr>					           expr-value;
%type <std::string>              string;

%%

prog-statement-list:
	  prog-statement
  | prog-statement-list prog-statement
  ;

prog-statement:
	  program
  | code
  | define
  | record-statement
  | EOS
  ;

program:
	  PROGRAM COL 
		  { nate.codeStartProgram(); }
	  EOS
	  BEGIN 
		  statement-list
	  END
		  { nate.codeEndProgram(); }
  ;
  
statement-list:
    statement
  | statement-list statement
  ;

statement: 
	  var-statement
  | assign-statement
  | output-statement
  | if-statement
  | loop-statement
  | return-statement
  | record-statement
  | expr-statement
  | EOS
  ;

define:
	  DEFINE 
		  { 
			  nate.addDefine();
			  pushState(lexer, Lexer::ARGS);
		  }
	  arg-list call-return COL
		  { 
			  popState(lexer);
			  pushState(lexer, Lexer::DEFINE);
			  nate.declareDefine();
		  }
	  EOS BEGIN
		  statement-list
	  END
		  { 
			  popState(lexer); 
			  nate.endDefine();
		  }
  ;

code:
	  CODE 
		  { 
			  nate.addCode();
			  pushState(lexer, Lexer::ARGS);
		  }
	  code-start
	  arg-list call-return COL
		  { 
			  popState(lexer);
			  pushState(lexer, Lexer::CODE);
		  }
	  BEGIN
		  code-stat-list
	  END
		  { 
			  popState(lexer); 
			  nate.endCode();
		  }
  ;

code-start:
	  "right" NUMBER 
		  { 
			  nate.curCode().setPriority(atoi($NUMBER.c_str())); 
			  nate.curCode().setFlag(Code::RightLeft, true);
		  }
  | NUMBER 
		  { 
			  nate.curCode().setPriority(atoi($NUMBER.c_str())); 
		  }
  ;
	
code-stat-list:
    code-stat
  | code-stat-list code-stat
  | BEGIN code-stat-list END
  ;

code-stat:
    WORD
		  { nate.curCode().addCodeStatWord($WORD); }
  | id
		  { nate.curCode().addCodeStatId($id); }
  ;
  
arg-list:
    arg
  | arg-list arg
  ;

arg:
    WORD
		  { nate.curMethod().addArgWord($WORD); }
  | OPENPAR inout arg-id[id] IS type 
		  { 
			  auto id = std::make_shared<Identifier>($id, nate.determineType($type));
			  nate.addIdentifier(id);
		    nate.curMethod().addArgId(id);
        if (!$inout.empty())
        {
          nate.curMethod().curArg().setArgFlag($inout);
        }
		  }
    opt-arg-flags CLOSEPAR
  | id-with-arg-flags
  ;

id-with-arg-flags:
    OPENPAR inout arg-id[id] IS
		{ 
			auto id = std::make_shared<Identifier>($id, std::make_shared<Type>(""));
			nate.addIdentifier(id);
		  nate.curMethod().addArgId(id);
      if (!$inout.empty())
      {
        nate.curMethod().curArg().setArgFlag($inout);
      }
		}
		arg-flags CLOSEPAR
  ;
 
arg-id:
    id
  | WORD
  ;

inout:
  %empty
    { $$ = ""; }
  | INOUT
    { $$ = "inout"; }
  ;
       
arg-flags:
    OPENPAR arg-flag-list CLOSEPAR
  ;

opt-arg-flags:
    %empty
  | arg-flags
  ;

arg-flag-list:
	  arg-flag
  | arg-flag-list COMMA arg-flag
  ;

arg-flag:
	  WORD
		  { 
        if (!nate.curMethod().curArg().setArgFlag($WORD))
        {
				  nate.error("Unknown argument type: " + $WORD);
        }
      }
  ;
  
call-return:
  %empty
		  { nate.curMethod().setReturnFlag("none"); }
	| IS type
		  { 
			  nate.curMethod().setType(std::make_shared<Type>($type));
		  }
  | IS call-return-flags 
  ;
  
call-return-flags:
    OPENPAR 
		call-return-flag-list 
	  CLOSEPAR
  ;

call-return-flag-list:
	  call-return-flag
  | call-return-flag-list COMMA call-return-flag
  ;

call-return-flag:
	  WORD
		  { nate.curMethod().setReturnFlag($WORD); }
  ;

var-statement:
	  var 
		  { pushState(lexer, Lexer::VAR_DECL); }
	  id-list 
		  { popState(lexer); }
	  is-type var-init-assign
		  { nate.codeDeclareLocalIdentifiers($[id-list], $[is-type], $[var-init-assign]); }
  ;

var:
	  VAR
  ;

id-list:
	  id
		  { $$.push_back($id); }
  | id-list COMMA id
		  { $$ = $1; $$.push_back($id); }
  ;

id:
	  IDENTIFIER
		  { $$ = ($IDENTIFIER[0] == '$') ? $IDENTIFIER.substr(1) : $IDENTIFIER; }
  ;

single-id:
	  id-list
		  {
			  if ($[id-list].size()>1)
			  {
				  nate.error("Expecting single identifier.");
			  }
			  $$ = $[id-list].front();
		  }
  ;

is-type:
    %empty
		  { $$ = ""; }
  | IS 
      { pushState(lexer, Lexer::DECL_TYPE); }
    type
	  	{ 
        popState(lexer);
        $$ = $type;
      }
  ;

type:
    WORD
  ;
  
var-init-assign:
	  %empty
		  { $$.clear(); }
  | ASSIGN var-init-list
		  { $$ = $[var-init-list]; }
  ;

var-init-list:
	  var-init
		  { $$.push_back($[var-init]); }
  | var-init-list[list] COMMA var-init
		  { $$ = $list; $$.push_back($[var-init]); }
  ;
  
var-init:
	  expr
  ;

record-statement:
    RECORD WORD[id] COL
      { 
        if (nate.curScope()->getType($id))
        {
				  nate.error("Duplicate type of :" + $id);
        }
        RecordPtr record = std::make_shared<Record>($id);
        nate.curScope()->addRecord(record);
        nate.codeStartRecord(record);
      }
    EOS BEGIN
    record-var-list
    EOS END
      { nate.codeEndRecord(); }
  ;

record-var-list:
    record-var
  | record-var-list record-var
  ;

record-var:
    var
		  { pushState(lexer, Lexer::VAR_DECL); }
	  id-list 
		  { popState(lexer); }
	  is-type var-init-assign
		  { nate.codeDeclareRecordIdentifiers($[id-list], $[is-type], $[var-init-assign]); }
  ;

assign-statement:
	  expr-list ASSIGN expr
		  { nate.codeAssign($[expr-list], $expr); }
  ;

expr-list:
	  expr
		  { $$.push_back($expr); }
  | expr-list COMMA expr
		  { $$ = $1; $$.push_back($expr); }
  ;

output-statement:
	  OUTPUT 
		  { 
        nate.codeOutputStart("std::cout");
        stateExprValue = yy::Lexer::OUTPUT_EXPR_VALUE;
      }
	  output-list
		  { 
        stateExprValue = yy::Lexer::EXPR_VALUE;
        nate.codeOutputEnd(outputEnd);
        outputEnd = true;
      }
  ;

output-list:
	  %empty
  | output-part-list
  ;

output-part-list:
	  output-part
  | output-part output-sep output-part-rest
  ;

output-part-rest:
	  %empty
		  { outputEnd = false; }
  | output-part-list
  ;

output-part:
	  expr
		  { nate.codeOutput($expr); }
  ;

output-sep:
	  COMMA
		  { nate.codeOutput("\" \""); }
	| CONCAT
  ;
      
if-statement:
	  IF expr COL
		  { nate.codeIf($expr); }
	  EOS BEGIN 
		  statement-list
		  { nate.codeEndIf(); }
	  END
	  else-statement
  ;

else-statement:
	  %empty
  | ELSE 
	  	{ nate.codeElseIf(); }
		  if-statement
  | ELSE COL 
		  { nate.codeElse(); }
    EOS BEGIN
		statement-list
		  { nate.codeEndIf(); }
	  END
  ;

loop-statement:
	  LOOP 
		  { 
        pushState(lexer, Lexer::LOOP);
        nate.codeInitLoop();
      }
	  for-part
	  EOS opt-while 
    BEGIN
		loop-part-statement-list
		  { 
        nate.codeEndLoop();
        popState(lexer);
      }
    END
  ;

for-part:
	  while-loop-statement
  | for-loop-statement
  | COL
		  { nate.codeStartLoop(); }
  ;

loop-part-statement-list:
	  loop-part-statement
  | loop-part-statement-list loop-part-statement
  ;
  
loop-part-statement:
	  statement
  | while-statement
  ;

while-loop-statement:
	  WHILE expr COL
		  { 
		    nate.codeStartLoop();
			  nate.codeLoopWhile($expr);
		  }
  ;
  
while-statement:
	  WHILE expr COL
		  { nate.codeLoopWhile($expr); }
  ;

opt-while:
	  %empty
  | while-statement EOS
  ;
 
for-loop-statement:
	  FOR var 
		  { pushState(lexer, Lexer::VAR_DECL); }
	  single-id 
		  { popState(lexer); }
	  is-type ASSIGN 
		  { stateExprValue = yy::Lexer::FOR_EXPR_VALUE; }
	  expr[from] for-to expr[to] step 
		  { 
			  stateExprValue = yy::Lexer::EXPR_VALUE;
			  nate.codeStartForLoop($[single-id], $[is-type], $[for-to], $from, $to, $step);
		  }
	  for-loop-part-end
  ;
  
for-to:
	  DOWNTO
		  { $$ = true; }
  | TO
		  { $$ = false; }
  ;

step:
	  %empty
		  { $$ = Expr(ExprNode("1", "1", nate.determineType("int-32"))); }
  | STEP expr
		  { $$ = $expr; }
  ;

for-loop-part-end:
	  while-statement
  | COL
  ;

return-statement:
    RETURN expr
      { nate.codeReturn($2); }
  ;
  
expr-statement:
    expr
      { nate.codeExpression($expr); }
  ;

expr:
	  expr-value-start
	  expr-value-parts
	  expr-end
		  { 
			  popState(lexer); 
			  $$ = nate.evaluate(Expr($[expr-value-start], $[expr-value-parts]));
		  }
 |	expr-word-start
	  expr-word-parts
	  expr-end
		  { 
			  popState(lexer); 
			  $$ = nate.evaluate(Expr($[expr-word-start], $[expr-word-parts]));
		  }
  ;

expr-end:
	  %empty
  | EOS
  ;

expr-value-parts:
	  %empty
		  { $$ = Expr(); }
  | expr-value-next expr-word-parts
		  { $$ = Expr($[expr-value-next], $[expr-word-parts]); }
  ;
  
expr-value-start:
	  expr-value
		  { $$ = $[expr-value]; pushState(lexer, stateExprValue); }
  ;
  
expr-value-next:
	  expr-word-part[part]
		  { $$ = Expr($part.node().text() == "+" ? "plus" : ($part.node().text() == "-" ? "minus" : $part.node().text())); }
  ;

expr-value-part:
	  expr-value
		  { $$ = $[expr-value]; setState(lexer, stateExprValue); }
  ;

expr-value:
	  NUMBER
		  { 
			  $$ = Expr(ExprNode($NUMBER, $NUMBER, Type::makeType($NUMBER)));
			  $$.node().setFlag(ExprNode::Literal, true);
		  }
	| FRACTION
		  { 
			  $$ = Expr(ExprNode($FRACTION, $FRACTION, Type::makeType($FRACTION)));
			  $$.node().setFlag(ExprNode::Literal, true);
		  }
  | string
		  { 
			  $$ = Expr(ExprNode($string, $string, nate.determineType("text")));
			  $$.node().setFlag(ExprNode::Literal, true);
		  }
  | BOOL
		  { 
			  $$ = Expr(ExprNode($BOOL, $BOOL, nate.determineType("boolean")));
			  $$.node().setFlag(ExprNode::Literal, true);
		  }
  | id
		  { 
			  $$ = Expr(ExprNode($id, nate.codeId($id), nate.getOrFakeIdentifier($id)->type()));
			  $$.node().setFlag(ExprNode::Output, true);
		  } 
  | OPENPAR expr CLOSEPAR
		  { $$ = nate.evaluate(Expr($expr)); }
  ;

expr-word-parts:
	  %empty
		  { $$ = Expr(); }
  | expr-word-next expr-word-parts[parts]
	  	{ $$ = Expr($[expr-word-next], $[parts]); }
  | expr-value-part expr-value-parts
	  	{ $$ = Expr($[expr-value-part], $[expr-value-parts]); }
  ;
    
expr-word-start:
	  expr-word
		  { $$ = $[expr-word]; pushState(lexer, Lexer::EXPR_WORD); }
  ;
  
expr-word-next:
	  expr-word-part
  ;

expr-word-part:
	  expr-word
		  { $$ = $[expr-word]; setState(lexer, Lexer::EXPR_WORD); }
  | IF
		  { $$ = Expr(ExprNode("if")); setState(lexer, Lexer::EXPR_WORD); }
  | ELSE
		  { $$ = Expr(ExprNode("else")); setState(lexer, Lexer::EXPR_WORD); }
  ;

expr-word:
    WORD
		  { $$ = Expr($WORD); }
  ;

string:
	  STRING
  ;

%%

void yy::parser::error(const location& loc, const std::string& msg)
{
  std::cerr << loc << ": " << msg << std::endl;
}